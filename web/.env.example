# Anda — web environment (PRD Phase 1: env configuration)
# Copy to `.env.local` and fill in with your Supabase project values.
# The anon key is a PUBLIC client token (Supabase anon role). Per PRD §21
# no privileged service-role secrets ever belong in the frontend.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<public-anon-key>